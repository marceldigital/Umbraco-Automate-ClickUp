<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow floating versions so extensions can align with the host Umbraco project's package versions -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Umbraco API packages - Used by extension templates -->
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="18.0.2" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="18.0.2" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="18.0.2" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="18.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Umbraco Automate - connection type base classes, OAuth credential pipeline -->
    <PackageVersion Include="Umbraco.Automate.Core" Version="18.0.0" />
    <PackageVersion Include="Umbraco.Automate.OpenIddict" Version="18.0.0" />
    <PackageVersion Include="OpenIddict.Client.WebIntegration" Version="7.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provides the JsonSchemaGenerate MSBuild task used to build appsettings-schema.Umbraco.Automate.ClickUp.json -->
    <GlobalPackageReference Include="Umbraco.JsonSchema.Extensions" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test site host -->
    <PackageVersion Include="Umbraco.Cms" Version="18.0.2" />
    <PackageVersion Include="Umbraco.Automate" Version="18.0.0" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="uSync" Version="18.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test project -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Umbraco.Automate.Testing" Version="18.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
